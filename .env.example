# Copy to .env and edit before running `bash set_env.sh`.
# `set_env.sh` sources this file and exports every variable below.

# IP of the current node — used as MASTER_ADDR for mpirun / NCCL rendezvous.
# On a single-node run this can be 127.0.0.1.
MY_NODE_IP=127.0.0.1

# Optional: LD_PRELOAD is forwarded to every mpirun worker. Leave empty if
# you do not need to preload a custom allocator / NCCL build.
LD_PRELOAD=
